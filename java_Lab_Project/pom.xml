<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Project Coordinates -->
    <groupId>com.shopsphere</groupId>
    <artifactId>shopsphere</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>war</packaging>

    <name>ShopSphere E-Commerce Application</name>
    <description>E-Commerce Application running on Apache Tomcat 9 with javax.servlet (Servlet 4.0)</description>

    <!-- Project Properties -->
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Java 21 is fully supported with Tomcat 9 (requires JDK 11+) -->
        <maven.compiler.release>21</maven.compiler.release>

        <!-- Dependency Versions -->
        <!-- javax.servlet-api 4.0.1 is the correct API for Tomcat 9 (Servlet 4.0 / JSP 2.3) -->
        <javax.servlet-api.version>4.0.1</javax.servlet-api.version>
        <mysql-connector.version>8.4.0</mysql-connector.version>
        <hikari.version>5.1.0</hikari.version>
        <jbcrypt.version>0.4</jbcrypt.version>
        <jackson.version>2.17.2</jackson.version>
        <!--
            JSTL 1.2 (javax namespace) is the correct version for Tomcat 9.
            Tomcat 9 ships its own EL implementation (el-api), so we do NOT
            bundle a separate EL jar.  JSTL 1.2 is a single-jar release that
            includes both the API and the implementation.
        -->
        <jstl.version>1.2</jstl.version>

        <!-- Plugin Versions -->
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-war-plugin.version>3.4.0</maven-war-plugin.version>
    </properties>

    <dependencies>
        <!-- ============================================================= -->
        <!-- javax Servlet API 4.0.1 for Apache Tomcat 9.0.x               -->
        <!-- Scope: provided (supplied by the Tomcat 9 container)           -->
        <!-- NOTE: Tomcat 9 uses javax.servlet.*, NOT jakarta.servlet.*     -->
        <!-- ============================================================= -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>${javax.servlet-api.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- ============================================================= -->
        <!-- MySQL Connector/J Database Driver                             -->
        <!-- ============================================================= -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql-connector.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ============================================================= -->
        <!-- Database Connection Pooling (HikariCP)                        -->
        <!-- HikariCP 5.x is compatible with Java 11+ and has no           -->
        <!-- jakarta.servlet dependency — safe to keep.                    -->
        <!-- ============================================================= -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>${hikari.version}</version>
        </dependency>

        <!-- ============================================================= -->
        <!-- Password Hashing (BCrypt)                                     -->
        <!-- ============================================================= -->
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>${jbcrypt.version}</version>
        </dependency>

        <!-- ============================================================= -->
        <!-- JSON Processing (Jackson)                                     -->
        <!-- No servlet dependency — safe to keep at 2.17.2.              -->
        <!-- ============================================================= -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- ============================================================= -->
        <!-- JSTL 1.2 (javax namespace — for Tomcat 9 / Servlet 4.0)      -->
        <!--                                                               -->
        <!-- JSTL 1.2 is a single consolidated JAR that contains both the -->
        <!-- API (javax.servlet.jsp.jstl.*) and the reference             -->
        <!-- implementation (org.apache.taglibs.*).                       -->
        <!--                                                               -->
        <!-- JSP taglib URIs to use in JSPs:                              -->
        <!--   <%@ taglib prefix="c"   uri="http://java.sun.com/jsp/jstl/core"  %> -->
        <!--   <%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"   %> -->
        <!--                                                               -->
        <!-- Tomcat 9 provides its own EL 3.0 implementation, so we do   -->
        <!-- NOT need to bundle a separate EL API/impl jar.              -->
        <!-- ============================================================= -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>jstl</artifactId>
            <version>${jstl.version}</version>
        </dependency>

        <!-- JUnit 5 for Unit & Integration Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <!-- Maven Compiler Plugin configured for Java 21 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>

            <!-- Maven WAR Plugin — no web.xml required with annotation scanning -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>${maven-war-plugin.version}</version>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                    <!--
                        Exclude the Jakarta-era JSTL JARs that were previously
                        bundled in WEB-INF/lib.  Maven now manages JSTL 1.2
                        via the dependency above.  This prevents duplicate/
                        conflicting javax vs jakarta JSTL classes in the WAR.
                    -->
                    <packagingExcludes>
                        WEB-INF/lib/jakarta.servlet.jsp.jstl-*.jar,
                        WEB-INF/lib/jakarta.servlet.jsp.jstl-api-*.jar,
                        WEB-INF/lib/jakarta.el-api-*.jar
                    </packagingExcludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
